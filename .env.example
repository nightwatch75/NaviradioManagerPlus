# Copy to .env and fill in:  cp .env.example .env
# Default interface language: IT, EN, FR, DE, ES or PT.
# It is only the starting language: users switch language from the flags in the sidebar.
APP_LANG=IT
TZ=Europe/Rome

# Base URL of your Navidrome, reachable from the container
NAVIDROME_URL=http://192.168.1.10:4533
NAVIDROME_USER=your_user
# Plain-text password (not a hash). If it contains a "$", write it as "$$" here.
NAVIDROME_PASS=your_password

# The salt is NOT stored anywhere in Navidrome: you choose it. It is any random string.
# The app sends token = md5(password + salt) and the salt (Subsonic API token auth).
# Generate one and paste it below:
#     openssl rand -hex 8
NAVIDROME_SALT=change_me_with_openssl_rand_hex_8
